    },
    {
      "name": "PaymentReportHelp",
      "title": "支付报告下载指南",
      "steps": [
        {
          "title": "进入支付报告",
          "content": [
            "1. 点击\"财务\"菜单",
            "2. 选择\"支付报告\""
          ],
          "image": "/static/images/help/payment_menu.png",
          "alt": "支付菜单"
        },
        {
          "title": "交易明细报告",
          "content": [
            "1. 选择日期范围",
            "2. 选择交易类型（收入/支出/退款等）",
            "3. 选择支付方式（可选）",
            "4. 点击\"导出报告\""
          ],
          "image": "/static/images/help/transaction_report.png",
          "alt": "交易报告"
        },
        {
          "title": "结算报告",
          "content": [
            "1. 切换到\"结算\"标签",
            "2. 选择结算周期",
            "3. 选择账户（如有多个）",
            "4. 下载结算报告"
          ]
        }
      ],
      "notes": {
        "title": "注意事项：",
        "items": [
          "交易数据通常有1-2天延迟；",
          "结算报告每月生成一次；",
          "可导出PDF或Excel格式；",
          "建议定期核对交易记录；",
          "异常交易请及时联系客服处理；",
          "重要财务数据请妥善保存。"
        ]
      }
    }
  ]
}